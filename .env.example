# Frontend config generator
VITE_RH_NETWORK=testnet
VITE_BUTTON_CONTRACT=
VITE_CONTRACT_DEPLOY_BLOCK=
VITE_BUTTON_TOKEN=
VITE_TOKEN_URL=
VITE_PAIR_LABEL=BUTTON / RDDT
# Optional: override the public RPC endpoint for the active network above (e.g. an
# Alchemy URL with an API key). The public rpc.*.chain.robinhood.com endpoints are
# rate-limited and not recommended for production per Robinhood Chain's own docs.
# This value ships in a public, client-loaded script — restrict any embedded key by
# allowed origin on the provider's dashboard rather than relying on it being hidden.
VITE_RH_RPC_URL=
# Optional: the deployment and activation transaction hashes, filled in by the
# operator after a real deployment (see scripts/deploy.sh / scripts/start.sh
# output, or contracts/broadcast/). Shown on the /proof page; left as "not yet
# recorded" rather than guessed when unset.
VITE_DEPLOY_TX=
VITE_START_TX=

# Contract deployment / activation
PRIVATE_KEY=
BUTTON_CONTRACT=
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
I_UNDERSTAND_MAINNET=

# /admin gate (web/middleware.ts) — deliberately NOT VITE_-prefixed: those get
# inlined into the public client bundle, which would defeat the point. Read only
# server-side, by Vercel Edge Middleware, at request time. Set both in the Vercel
# project's own environment variables (not committed here) — if either is unset,
# /admin returns 401 for everyone, including the real starter. Has no effect on
# `npm run dev` / `vite preview`, which don't run Vercel Middleware; local admin
# access stays open, same as before this existed.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
